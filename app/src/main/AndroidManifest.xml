<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Google Maps a besoin d'Internet pour charger les tuiles -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Caméra (prise de photo du contact) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Écriture MediaStore pour la photo caméra (Android 9 et moins) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Aucune permission de localisation : on affiche des coordonnées déjà enregistrées -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Clé Google Maps injectée depuis local.properties (non publiée sur GitHub) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Activité unique : héberge tous les fragments -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
